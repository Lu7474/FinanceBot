# Токен бота от @BotFather (обязательно)
BOT_TOKEN=your_bot_token_here

# Telegram ID администратора (для /admin команды)
ADMIN_ID=0

# Прокси для обхода блокировок (необязательно, оставьте пустым если не нужен)
# Форматы: socks5://user:pass@host:port или http://host:port
PROXY_URL=

# URL базы данных (по умолчанию SQLite в корне проекта)
DATABASE_URL=sqlite+aiosqlite:///db.sqlite3

# Self-hosted telegram-bot-api (https://github.com/tdlib/telegram-bot-api)
# для файлов >50MB или своего инстанса Bot API. Приоритет над PROXY_URL.
# НЕ для nginx-reverse-proxy на api.telegram.org — это бесполезно для polling.
# Пример: http://localhost:8081
# BOT_API_BASE_URL=
